# Dependencies
node_modules/
vendor/

# Build output
frontend/dist/

# Env & secrets — never commit
backend/.env

# Assembled production upload bundle (contains the filled prod .env). Local only.
_deploy/

# Local throwaway dev database (isolated MySQL 8.0 instance)
.devdb/

# Uploaded media — keep the folder, ignore the contents
/uploads/*
!/uploads/.gitkeep

# OS / editor noise
.DS_Store
*.log

# Claude Code worktree scratch space (launch.json is committed, this is not)
.claude/worktrees/

# Vendor font download — only the three cuts in frontend/public/fonts/ are used
Anthropic Serif-fontiko/

# Generated by deployment/scripts/pending-sql.sh for one phpMyAdmin paste — it
# duplicates backend/migrations/, so it would only go stale in here.
prod-migrations.sql
