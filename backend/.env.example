# Copy to backend/.env and fill in. Never commit .env.
APP_ENV=development

# Secret key for HMAC (CSRF tokens, IP hashing). Generate a unique one:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=our_journey
DB_USER=root
DB_PASS=

# Sessions / cookies (PLAN_REVIEW A4 — DB-token visitor gate)
SESSION_DURATION_DAYS=30
COOKIE_SECURE=false        # set true in production (HTTPS only)
