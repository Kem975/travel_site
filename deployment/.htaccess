# Our Journey — production SPA + API routing (PLAN_REVIEW A1)
RewriteEngine On

# 1) API: route everything under /api to the PHP front controller, which parses
#    the sub-path itself. (The naive `RewriteRule ^api/ - [L]` 404s real routes.)
RewriteRule ^api/(.*)$ api/index.php [L,QSA]

# 2) Serve real files and directories as-is (hashed assets, uploaded images).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3) Build output is never a route. Without this a missing chunk falls through to
#    the shell below and arrives as an HTML document with a 200, which a dynamic
#    import fails on with a message that names the file but not the cause. Let it
#    404 honestly instead — an incomplete upload should look like one.
RewriteRule ^(assets|fonts|tiles)/ - [R=404,L]

# 4) SPA fallback: every other route renders the React shell.
RewriteRule ^ index.html [L]

# --- Caching ---
# Without this the server sends no Cache-Control, no ETag and no Last-Modified, so
# browsers fall back to heuristic caching and keep serving a stale index.html —
# which points at the previous build's hashed assets. Every deploy then appears to
# do nothing until the visitor happens to hard-reload.
<IfModule mod_headers.c>
    # The shell is the pointer to everything else: always revalidate it. It is under
    # a kilobyte, so the round-trip costs nothing.
    <FilesMatch "^(index\.html|favicon\.svg)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Everything under /assets carries a content hash in its filename, so a changed
    # file is a different URL: it can be cached indefinitely and never revalidated.
    <FilesMatch "\.(js|css|woff2?|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Terrain tiles are static and regenerated by hand at most once a year.
    <FilesMatch "\.(webp|png|jpe?g)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# --- Hardening ---
Options -Indexes

# Block dotfiles and sensitive extensions (.env, dumps, logs, configs, sources).
<FilesMatch "(^\.|\.(env|sql|log|ini|sh|lock)$)">
    Require all denied
</FilesMatch>
